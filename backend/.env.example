# EKTA ELECTRICAL WORKS - Backend Environment Configuration

# Application
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ekta_electricals

# Authentication & Security
JWT_SECRET=change_this_to_a_secure_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,https://admin-ochre-one-53.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Media Uploads
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Email Notifications (optional; enquiry submission still works without SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASSWORD=change_this_password
MAIL_FROM=notifications@example.com
ENQUIRY_NOTIFICATION_EMAIL=Ektaa.electrical@gmail.com
SEND_CUSTOMER_ACKNOWLEDGEMENT=false
